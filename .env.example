# Copy this file to ".env" and put your own key in it. Never commit ".env" (it is in .gitignore).
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Optional settings (the defaults below are used when these lines are omitted) ---
# Model that writes the answer. Change it if Google retires this model name.
# GEMINI_CHAT_MODEL=gemini-3.7-flash
# Model that turns text into vectors. Keep it the same between indexing and asking.
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Port of the assistant backend (the Vite dev server proxies /api to 8787).
# PORT=8787
# How many chunks to retrieve per question.
# RAG_TOP_K=4
# Minimum cosine similarity (0-1) for a chunk to count as relevant. Tune with: npm run retrieve -- "question"
# RAG_MIN_SIMILARITY=0.4
